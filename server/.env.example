# =============================================================================
# NOURLA HOTEL — BACKEND ENVIRONMENT VARIABLES
# =============================================================================

# Sunucu & Genel Yapılandırma
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
DATABASE_PATH=./nourla_hotel.sqlite

# -----------------------------------------------------------------------------
# 1. ELEKTRAWEB PMS ENTEGRASYONU
# -----------------------------------------------------------------------------
ELEKTRA_API_BASE_URL=https://bookingapi.elektraweb.com
ELEKTRA_HOTEL_ID=37555
ELEKTRA_API_TOKEN=YOUR_ELEKTRA_API_TOKEN_HERE
ELEKTRA_USERNAME=
ELEKTRA_PASSWORD=
ELEKTRA_TOKEN_CACHE_TTL=86400

# -----------------------------------------------------------------------------
# 2. ÖDEME MİMARİSİ (PAYMENT PROVIDER)
# Options: 'mock' (Varsayılan test gateway) | 'ziraat' (Canlı Ziraat POS)
# -----------------------------------------------------------------------------
PAYMENT_PROVIDER=mock
PAYMENT_HASH_SECRET=nourla_secure_payment_hash_secret_key_2026

# -----------------------------------------------------------------------------
# 3. ZİRAAT BANKASI SANAL POS ENTEGRASYONU
# (Ziraat Bankası bilgileri geldiğinde doldurulacaktır)
# -----------------------------------------------------------------------------
ZIRAAT_MERCHANT_ID=
ZIRAAT_TERMINAL_ID=
ZIRAAT_CLIENT_ID=
ZIRAAT_USERNAME=
ZIRAAT_PASSWORD=
ZIRAAT_STORE_KEY=
ZIRAAT_ENVIRONMENT=test
ZIRAAT_API_URL=https://entegrasyon.ziraatbank.com.tr/fim/api
ZIRAAT_GATEWAY_URL=https://entegrasyon.ziraatbank.com.tr/fim/est3Dgate
