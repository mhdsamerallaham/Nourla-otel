# Nourla Hotel Backend — Environment Variables Template
# Duplicate this file as server/.env for local backend development.
# NEVER commit actual secrets, API tokens, or passwords to Git.

# Server Configuration
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
DATABASE_PATH=./nourla_hotel.sqlite

# Elektraweb PMS Entegrasyonu
ELEKTRA_API_BASE_URL=https://bookingapi.elektraweb.com
ELEKTRA_HOTEL_ID=37555
ELEKTRA_TOKEN_CACHE_TTL=86400
ELEKTRA_EMAIL=your-elektra-email@domain.com
ELEKTRA_PASSWORD=your-elektra-password
ELEKTRA_API_TOKEN=your-elektra-api-token-if-using-token

# Payment Provider Configuration
PAYMENT_PROVIDER=mock
PAYMENT_HASH_SECRET=your_secret_hash_salt_here

# Ziraat Bankası Sanal POS (Production / Test)
ZIRAAT_MERCHANT_ID=
ZIRAAT_TERMINAL_ID=
ZIRAAT_CLIENT_ID=
ZIRAAT_USERNAME=
ZIRAAT_PASSWORD=
ZIRAAT_STORE_KEY=
ZIRAAT_ENVIRONMENT=test

# Supabase Server-side (Mail Order Lead Storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
